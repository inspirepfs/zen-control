# ZEN Control environment configuration contract
#
# Keep this file name-for-name aligned with docker-compose.yml host interpolation.
# `python3 scripts/env_validate.py` also audits source environment references and,
# when a local .env exists, validates required/conditional settings without ever
# printing secret values. Runtime-only container variables are intentionally not
# duplicated here.

# Web authentication
ADMIN_USER=parent
ADMIN_PASSWORD=replace-with-a-long-random-password
SESSION_SECRET=replace-with-at-least-32-random-bytes

# TOTP secret encryption. Keep this stable once authenticators are enrolled.
# Generate with: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
OTP_ENCRYPTION_KEY=replace-with-a-separate-stable-random-secret
OTP_ISSUER=ZEN Control

# MikroTik RouterOS API
MIKROTIK_HOST=192.168.1.1
MIKROTIK_PORT=8728
MIKROTIK_USER=mikrotik-control
MIKROTIK_PASSWORD=replace-with-router-api-password

# PostgreSQL telemetry
TELEMETRY_DB_NAME=mikrotik
TELEMETRY_DB_USER=mikrotik
TELEMETRY_DB_PASSWORD=replace-with-random-database-password

# Pi-hole web/API password used by the telemetry stack
PIHOLE_PASSWORD=replace-with-random-pihole-password

# Optional Parent Summary Delivery (v0.25)
# Delivery is disabled in the UI until explicitly enabled. SMTP secrets remain
# environment-only; recipient addresses and webhook URL are stored in policy.db.
SUMMARY_SMTP_HOST=
SUMMARY_SMTP_PORT=587
SUMMARY_SMTP_USERNAME=
SUMMARY_SMTP_PASSWORD=
SUMMARY_SMTP_FROM=
SUMMARY_SMTP_STARTTLS=1

# Optional bearer token sent as Authorization: Bearer <token> to summary webhooks.
SUMMARY_WEBHOOK_TOKEN=

# Background outbox poll interval. 30 seconds is recommended.
SUMMARY_DELIVERY_POLL_SECONDS=30

# v0.55.2 standard Web Push. ZEN generates the P-256 VAPID private key in
# the persistent /data volume automatically. Set a real contact URI if desired.
ZEN_PUSH_VAPID_SUBJECT=mailto:zen-control@example.invalid
ZEN_PUSH_POLL_SECONDS=5

# v0.55.4 external notification delivery
# SMTP is completely environment-backed. ZEN never stores the password or
# recipient configuration in policy.db. Set STARTTLS=0 for the local Mailpit
# simulator only; production SMTP should use STARTTLS or SSL.
ZEN_SMTP_ENABLED=0
ZEN_SMTP_HOST=
ZEN_SMTP_PORT=587
ZEN_SMTP_USERNAME=
ZEN_SMTP_PASSWORD=
ZEN_SMTP_FROM=
ZEN_SMTP_FROM_NAME=ZEN Control
ZEN_SMTP_TO=
ZEN_SMTP_STARTTLS=1
ZEN_SMTP_SSL=0
ZEN_SMTP_TIMEOUT_SECONDS=10

# Webhook destination URL/name are configured in the ZEN UI. The signing
# secret remains environment-only and signs timestamp + "." + raw JSON body.
ZEN_WEBHOOK_SIGNING_SECRET=
ZEN_WEBHOOK_TIMEOUT_SECONDS=10
ZEN_WEBHOOK_MAX_ATTEMPTS=5
# Leave 0 in production. Set to 1 only to use the local HTTP webhook simulator.
ZEN_WEBHOOK_ALLOW_HTTP=0
ZEN_EXTERNAL_MAX_ATTEMPTS=5
ZEN_EXTERNAL_DELIVERY_POLL_SECONDS=5

# Local v0.55.4 simulator example (with `docker compose --profile test-tools up -d`):
# ZEN_SMTP_ENABLED=1
# ZEN_SMTP_HOST=mailpit
# ZEN_SMTP_PORT=1025
# ZEN_SMTP_FROM=zen@example.test
# ZEN_SMTP_TO=parent@example.test
# ZEN_SMTP_STARTTLS=0
# ZEN_WEBHOOK_SIGNING_SECRET=replace-with-a-random-test-secret
# ZEN_WEBHOOK_ALLOW_HTTP=1
# Then configure webhook URL in ZEN as: http://webhook-sink:8092/webhook


# v0.54.4 formal performance acceptance (bounded, in-memory only).
# Restart or use the UI reset before a deliberate acceptance run. SQL previews
# contain only static application SQL, not parameter values.
ZEN_PERF_ENABLED=1
ZEN_PERF_SAMPLE_LIMIT=500
ZEN_PERF_COMPONENT_LIMIT=2000
ZEN_PERF_SLOW_MS=1000
ZEN_PERF_SQL_PREVIEW=1
ZEN_PERF_ACCEPTANCE_MIN_SAMPLES=5
ZEN_PERF_ACCEPTANCE_RECOMMENDED_SAMPLES=20
ZEN_PERF_BUDGET_NAVIGATION_MS=1000
ZEN_PERF_BUDGET_LOCAL_WRITE_MS=750
ZEN_PERF_BUDGET_ROUTER_ACTION_MS=2000
ZEN_PERF_BUDGET_ROUTER_READ_MS=1500

# v0.54.2 bounded parallel RouterOS observation/planning. This affects only
# read-side automatic-reconciler planning; RouterOS mutations remain serialized.
# Values are clamped to 1-8 by the application.
ZEN_ROUTER_OBSERVE_WORKERS=4


# v0.56 secure transport / PWA commissioning.
# Local HTTPS is commissioned first; remote Access remains optional. Enable Secure
# cookies only after the HTTPS hostname works and ZEN_ALLOWED_HOSTS covers both
# ZEN_LOCAL_HOST and 127.0.0.1 (plus ZEN_PUBLIC_HOST when remote access is on).
ZEN_REMOTE_ACCESS_ENABLED=0
ZEN_SECURE_COOKIES=0
ZEN_PUBLIC_HOST=
ZEN_ALLOWED_HOSTS=
ZEN_CLOUDFLARE_ACCESS_PROTECTED=0
ZEN_HSTS_MAX_AGE=31536000

# Path on the Docker host to the remotely-managed Tunnel token file.
# File-backed Compose secrets preserve host ownership. The pinned cloudflared
# image runs as 65532:65532, so use host ownership root:65532 and mode 0640.
# Keep it outside the source tree; never paste the token into Compose/command args.
CLOUDFLARE_TUNNEL_TOKEN_FILE=

# Local HTTPS / split-DNS endpoint
# LAN DNS should resolve this hostname directly to ZEN_LAN_BIND_IP.
# Public DNS may independently use Cloudflare Access + Tunnel.
ZEN_LOCAL_HOST=zen.example.com
ZEN_LAN_BIND_IP=192.168.1.10
ZEN_LAN_CIDRS=192.168.1.0/24
CADDY_CF_API_TOKEN=replace-with-cloudflare-dns-api-token
