# Web authentication
ADMIN_USER=parent
ADMIN_PASSWORD=replace-with-a-long-random-password
SESSION_SECRET=replace-with-at-least-32-random-bytes

# TOTP secret encryption. Keep this stable once authenticators are enrolled.
# Generate with: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
OTP_ENCRYPTION_KEY=replace-with-a-separate-stable-random-secret
OTP_ISSUER=ZEN Control

# MikroTik RouterOS API
MIKROTIK_HOST=192.168.1.1
MIKROTIK_PORT=8728
MIKROTIK_USER=mikrotik-control
MIKROTIK_PASSWORD=replace-with-router-api-password

# PostgreSQL telemetry
TELEMETRY_DB_NAME=mikrotik
TELEMETRY_DB_USER=mikrotik
TELEMETRY_DB_PASSWORD=replace-with-random-database-password

# Pi-hole web/API password used by the telemetry stack
PIHOLE_PASSWORD=replace-with-random-pihole-password

# Optional Parent Summary Delivery (v0.25)
# Delivery is disabled in the UI until explicitly enabled. SMTP secrets remain
# environment-only; recipient addresses and webhook URL are stored in policy.db.
SUMMARY_SMTP_HOST=
SUMMARY_SMTP_PORT=587
SUMMARY_SMTP_USERNAME=
SUMMARY_SMTP_PASSWORD=
SUMMARY_SMTP_FROM=
SUMMARY_SMTP_STARTTLS=1

# Optional bearer token sent as Authorization: Bearer <token> to summary webhooks.
SUMMARY_WEBHOOK_TOKEN=

# Background outbox poll interval. 30 seconds is recommended.
SUMMARY_DELIVERY_POLL_SECONDS=30


# v0.30 performance gathering (bounded, in-memory only)
# Leave enabled while gathering the v0.30 baseline. Restart or use the UI reset
# to clear samples. SQL previews contain only static application SQL, not values.
ZEN_PERF_ENABLED=1
ZEN_PERF_SAMPLE_LIMIT=500
ZEN_PERF_COMPONENT_LIMIT=2000
ZEN_PERF_SLOW_MS=1000
ZEN_PERF_SQL_PREVIEW=1
ZEN_PERF_ACCEPTANCE_MIN_SAMPLES=5
ZEN_PERF_BUDGET_NAVIGATION_MS=1000
ZEN_PERF_BUDGET_LOCAL_WRITE_MS=750
ZEN_PERF_BUDGET_ROUTER_ACTION_MS=2000
ZEN_PERF_BUDGET_ROUTER_READ_MS=1500


# v0.51 secure transport / Cloudflare Tunnel
# Leave disabled until the Access application and Tunnel route are configured.
ZEN_REMOTE_ACCESS_ENABLED=0
ZEN_SECURE_COOKIES=0
ZEN_PUBLIC_HOST=
ZEN_ALLOWED_HOSTS=
ZEN_CLOUDFLARE_ACCESS_PROTECTED=0
ZEN_HSTS_MAX_AGE=31536000

# Path on the Docker host to the remotely-managed Tunnel token file.
# File-backed Compose secrets preserve host ownership. The pinned cloudflared
# image runs as 65532:65532, so use host ownership root:65532 and mode 0640.
# Keep it outside the source tree; never paste the token into Compose/command args.
CLOUDFLARE_TUNNEL_TOKEN_FILE=

# Local HTTPS / split-DNS endpoint
# LAN DNS should resolve this hostname directly to ZEN_LAN_BIND_IP.
# Public DNS may independently use Cloudflare Access + Tunnel.
ZEN_LOCAL_HOST=zen.example.com
ZEN_LAN_BIND_IP=192.168.1.10
ZEN_LAN_CIDRS=192.168.1.0/24
CADDY_CF_API_TOKEN=replace-with-cloudflare-dns-api-token
