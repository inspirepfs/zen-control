:if ([:len [find where comment="RW11 - Block GoogleVideo"]] = 1) do={ set [find where comment="RW11 - Block GoogleVideo"] chain=restricted-web action=drop src-address-list=MC_Block_YouTube dst-address-list=Detected_GoogleVideo disabled=no }
