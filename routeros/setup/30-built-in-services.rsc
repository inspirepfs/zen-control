# ZEN Control built-in TLS/SNI service contract.
# Idempotent by exact comment; fails on duplicates. Mirrors app/service_catalog.py.
# Static rules are operator-owned after installation; ZEN runtime manages MC_Block_* membership only.
/ip firewall filter
:if ([:len [find where comment="RW99 - Return"]] != 1) do={ :error "Expected exactly one RW99 - Return anchor" }
:local rwReturn [find where comment="RW99 - Return"]

# ---- Service drop rules: WHO (MC_Block_*) + WHAT (Detected_*) ----
:if ([:len [find where comment="RW10 - Block YouTube"]] > 1) do={ :error "Duplicate RW10 - Block YouTube" }
:if ([:len [find where comment="RW10 - Block YouTube"]] = 0) do={ add chain=restricted-web action=drop src-address-list=MC_Block_YouTube dst-address-list=Detected_YouTube log=yes log-prefix="ZEN-SVC " disabled=no comment="RW10 - Block YouTube" place-before=$rwReturn }
:if ([:len [find where comment="RW10 - Block YouTube"]] = 1) do={ set [find where comment="RW10 - Block YouTube"] chain=restricted-web action=drop src-address-list=MC_Block_YouTube dst-address-list=Detected_YouTube disabled=no }
:if ([:len [find where comment="RW11 - Block GoogleVideo"]] > 1) do={ :error "Duplicate RW11 - Block GoogleVideo" }
