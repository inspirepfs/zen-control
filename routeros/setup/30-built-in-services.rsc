# ---- TLS/SNI learners: retain detected destination addresses for 30 minutes ----
:if ([:len [find where comment="RW03 - Learn YouTube"]] > 1) do={ :error "Duplicate RW03 - Learn YouTube" }
:if ([:len [find where comment="RW03 - Learn YouTube"]] = 0) do={ add chain=restricted-web action=add-dst-to-address-list protocol=tcp dst-port=443 address-list=Detected_YouTube address-list-timeout=30m tls-host="*youtube*" log=yes log-prefix="ZEN-LEARN " disabled=no comment="RW03 - Learn YouTube" place-before=$rwReturn }
:if ([:len [find where comment="RW03 - Learn YouTube"]] = 1) do={ set [find where comment="RW03 - Learn YouTube"] chain=restricted-web action=add-dst-to-address-list protocol=tcp dst-port=443 address-list=Detected_YouTube address-list-timeout=30m tls-host="*youtube*" disabled=no }
