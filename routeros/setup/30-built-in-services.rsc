:if ([:len [find where comment="RW12 - Block ChatGPT"]] = 1) do={ set [find where comment="RW12 - Block ChatGPT"] chain=restricted-web action=drop src-address-list=MC_Block_ChatGPT dst-address-list=Detected_ChatGPT disabled=no }
